<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Espaciado, radios y tamaños habituales en PNET/src/public/css/styles.css y base.css.
        Valores en dp ≈ px del diseño web a escala 1:1.
    -->

    <!-- Contenedor .container: padding 20px (10px en &lt;=768px → valores-sw600dp si hace falta) -->
    <dimen name="heist_screen_padding">20dp</dimen>
    <dimen name="heist_screen_padding_compact">10dp</dimen>

    <dimen name="heist_card_padding">15dp</dimen>
    <dimen name="heist_card_padding_horizontal">15dp</dimen>

    <!-- Escala de gaps (flex/grid) -->
    <dimen name="heist_gap_xs">5dp</dimen>
    <dimen name="heist_gap_sm">10dp</dimen>
    <dimen name="heist_gap_md">15dp</dimen>
    <dimen name="heist_gap_lg">16dp</dimen>
    <dimen name="heist_gap_xl">20dp</dimen>
    <dimen name="heist_gap_xxl">30dp</dimen>
    <dimen name="heist_gap_2xl">32dp</dimen>

    <!-- base.css: label margin-bottom 5px; inputs padding 8px; radius 8px -->
    <dimen name="heist_label_margin_bottom">5dp</dimen>
    <dimen name="heist_input_padding">8dp</dimen>

    <!-- styles.css: header min-height 70px, padding-inline 2rem, gap 30px -->
    <dimen name="heist_header_min_height">70dp</dimen>
    <dimen name="heist_header_padding_horizontal">32dp</dimen>
    <dimen name="heist_header_gap">30dp</dimen>

    <!-- nav gap 16px; nav link padding -->
    <dimen name="heist_nav_gap">16dp</dimen>
    <dimen name="heist_nav_link_padding_vertical">12dp</dimen>

    <!-- aside width 250px; sticky top ~90px → offset manual en Compose -->
    <dimen name="heist_aside_width">250dp</dimen>

    <!-- .card img height 150px; .btn-edit 40px; .carousel-slide height 350px / 250px móvil -->
    <dimen name="heist_card_image_height">150dp</dimen>
    <dimen name="heist_icon_button_size">40dp</dimen>
    <dimen name="heist_carousel_slide_height">350dp</dimen>
    <dimen name="heist_carousel_slide_height_compact">250dp</dimen>

    <!-- .btn-cart 50px; .a11y-btn 50px; offsets bottom/right 30px -->
    <dimen name="heist_fab_size">50dp</dimen>
    <dimen name="heist_fab_margin_edge">30dp</dimen>

    <!-- Radios: 8px card/aside/input; 12px modal/faq; 14px .horizontal-search-bar; 20px .more-info; 30px .btn-book -->
    <dimen name="heist_radius_sm">8dp</dimen>
    <dimen name="heist_radius_md">12dp</dimen>
    <dimen name="heist_radius_search_bar">14dp</dimen>
    <dimen name="heist_radius_chip">20dp</dimen>
    <dimen name="heist_radius_button_pill">30dp</dimen>
    <dimen name="heist_radius_full">999dp</dimen>

    <!-- Modales: padding 20px; close-btn top/right -->
    <dimen name="heist_modal_padding">20dp</dimen>
    <dimen name="heist_modal_close_inset">15dp</dimen>
</resources>
