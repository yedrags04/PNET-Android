# --- Opción recomendada (contraseñas con @ # $ % etc. sin romper la URL) ---
# Comenta o elimina MONGODB_URL si usas esto.
MONGODB_USER=ivysudadera_db_user
MONGODB_PASSWORD='pega_la_contraseña_de_atlas_aqui'
MONGODB_CLUSTER_HOST=cluster0.ketrpdw.mongodb.net
# Nombre de la base de datos en Atlas (Browse Collections), no el nombre del cluster.
MONGODB_NAME=nombre_de_tu_base_de_datos
PORT=3000

# --- Opción alternativa: cadena completa desde Atlas (Connect → Drivers) ---
# La contraseña en la URL debe estar codificada si tiene caracteres especiales.
# MONGODB_URL=mongodb+srv://USUARIO:PASSWORD_CODIFICADA@cluster.mongodb.net/?appName=Cluster0
